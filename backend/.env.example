# Copy this file to ".env" and fill in the values. Never commit ".env".

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Name shown in the "x-served-by" response header, so you can see which
# server behind the load balancer answered a request.
INSTANCE_ID=backend-local

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tracking?retryWrites=true&w=majority

# Connection pool, PER backend server.
# Total connections to Atlas = MONGO_MAX_POOL_SIZE x number of backend servers.
# Keep that total well under your Atlas tier limit (M0 free tier = 500).
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2

# Optional. Leave empty to run without the cache (fine for local development).
# Docker Compose sets this to redis://redis:6379 automatically.
REDIS_URL=

# How long a tracking lookup stays cached, in seconds.
CACHE_TTL_SECONDS=30

# Signs admin login tokens. At least 32 random characters, and the SAME value
# on every backend server. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Public address of the website; used for the "Track shipment" link in emails.
SITE_URL=http://localhost:3000

# Address lookup for clients and hubs (OpenStreetMap, free, no key needed).
GEOCODER_URL=https://nominatim.openstreetmap.org

# Email sending through Resend (resend.com, free tier). Leave both empty until your
# domain is verified there; until then shipments work but no emails are sent.
RESEND_API_KEY=
MAIL_FROM=Westbridge International Logistics <info@yourdomain.com>